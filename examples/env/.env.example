# Settings for examples/env/run_train.py, run_fine_tune.py and run_predict.py. Copy to examples/env/.env and edit.
# ${REPO} = the repository root, ${HERE} = examples/env; keys may use ${OTHER_KEY}. Every key: examples/env/cmb_env.py.
# REQUIRED: one cohort folder as in the README section "Data" (with derivatives/preprocessed/<case>/)
CMB_DATA=${REPO}/examples/train
# name of the cohort in output paths (empty: the folder name)
NAME=
# where models and predictions go
CMB_RUNS=${REPO}/../my_runs
# participants.tsv columns (a missing count comes from the masks, missing folds are drawn once and kept)
ID_COLUMN=participant_id
COUNT_COLUMN=n_cmb
FOLD_COLUMN=fold
N_FOLDS=5
FOLD_SEED=0
# --- which cases ---
# empty = all cases; 0..N_FOLDS-1 = train on the other folds, predict only this fold
TEST_FOLD=
# empty = all training cases; a number = that many, stratified by microbleed count (nested draws)
N_SCANS=
DRAW_SEED=0
# --- training ---
# empty = 60
EPOCHS=
# empty = 0.0003 for training, 0.0001 for fine-tuning
LR=
# optional cmbx YAML with further settings (docs/DETAILS.md)
CONFIG=
# fine-tune: pretrained (VALDO T2*, CC BY-NC-SA 4.0) or a model folder
START_MODEL=pretrained
# fine-tune: levels to train, e.g. "1 2" (empty = all)
LEVELS=
# --- predict ---
# pretrained or a model folder, e.g. ${CMB_RUNS}/train/finetune_valdo_all
MODEL=pretrained
# empty = <CMB_RUNS>/<NAME>/predict_<model name>_<all|foldk>
OUT_DIR=
# auto | cuda | cuda:N | cpu
DEVICE=auto
# empty = the values chosen in training
THRESHOLD=
MIN_SIZE=
WORKERS=4
