# Paths for the tutorials in examples/python (read by cmbx.env()). Relative paths count from this folder (the
# repository root). Filled for the synthetic examples shipped with the repository: a fresh clone runs as is.
# For your own data edit only this file; .env.example explains every variable.
CMB_INPUT_DIR=examples/train/derivatives
CMB_LABEL_DIR=examples/train/derivatives/preprocessed
CMB_MODEL_DIR=../my_runs/tutorial_model
CMB_FINETUNED_DIR=../my_runs/tutorial_finetuned
CMB_OUTPUT_DIR=../my_runs/tutorial_pred
CMB_SCAN=examples/new/derivatives/preprocessed/phantom-00/phantom-00_t2star.nii.gz
CMB_BRAIN_MASK=examples/new/derivatives/preprocessed/phantom-00/phantom-00_brainmask.nii.gz
CMB_TRAIN_CONFIG=configs/quick_train.yaml
CMB_FINETUNE_CONFIG=configs/quick_finetune.yaml
