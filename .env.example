# Copy to .env (or edit .env directly) to run the tutorials in examples/python on your own data.
# One KEY=VALUE per line. Relative paths count from the folder that holds the .env (the repository root), so the
# tutorials work from any current folder; absolute paths work too. A variable set in the shell wins over the file.

# Training input (tutorial_train.py, tutorial_finetune.py): the dataset folder of README "Data", i.e. the folder that
# holds images/ and frsts/ (MicrobleedNet inputs), or the preprocessed/ folder with one subfolder per case.
CMB_INPUT_DIR=examples/train/derivatives
# Folder with the microbleed masks: <case>/<case>_cmb.nii.gz (usually the preprocessed/ folder).
CMB_LABEL_DIR=examples/train/derivatives/preprocessed
# Where tutorial_train.py writes the trained model (final/model.pt, config, threshold).
CMB_MODEL_DIR=../my_runs/tutorial_model
# Where tutorial_finetune.py writes the fine-tuned pretrained model.
CMB_FINETUNED_DIR=../my_runs/tutorial_finetuned
# Where tutorial_predict.py writes the microbleed mask, label map, probability map and predictions.csv.
CMB_OUTPUT_DIR=../my_runs/tutorial_pred
# The scan to predict (tutorial_predict.py): a bias-corrected, skull-stripped T2*-GRE NIfTI.
CMB_SCAN=examples/new/derivatives/preprocessed/phantom-00/phantom-00_t2star.nii.gz
# Its brain mask on the same matrix.
CMB_BRAIN_MASK=examples/new/derivatives/preprocessed/phantom-00/phantom-00_brainmask.nii.gz
# Quick-try settings for the synthetic examples (few patches, narrow network for training from scratch).
# For your own data leave both EMPTY (KEY=): the full recipe is used.
CMB_TRAIN_CONFIG=configs/quick_train.yaml
CMB_FINETUNE_CONFIG=configs/quick_finetune.yaml
